{
  "name": "@ensiria/cli-kit",
  "version": "0.0.0",
  "description": "Helpers and constants for scripts and command-line tools that all look and behave the same: typed options and generated help, output and formatting helpers, spinners, progress, task lists, prompts, man pages and completions, and test helpers.",
  "keywords": [
    "cli",
    "command-line",
    "terminal",
    "script",
    "parseArgs",
    "spinner",
    "progress",
    "prompts",
    "table",
    "completions"
  ],
  "license": "MIT",
  "author": "Jason Scoppetta",
  "homepage": "https://github.com/Ensiria/cli-kit#readme",
  "bugs": {
    "url": "https://github.com/Ensiria/cli-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ensiria/cli-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "bin": {
    "cli-kit": "./bin/cli-kit.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/src/*.d.ts",
        "default": "./dist/src/*.js"
      }
    },
    "bin": {
      "cli-kit": "./dist/bin/cli-kit.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "lint": "biome ci . && eslint .",
    "format": "biome check --write .",
    "prepack": "pnpm build",
    "checks": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@nx/js": "24.0.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "nx": "24.0.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "nx": {
    "name": "@ensiria/cli-kit"
  }
}
