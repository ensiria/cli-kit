{
  "name": "@ensiria/cli-kit",
  "version": "0.1.3",
  "description": "Write a Node script's definition once and get the parser, the help, completions and man pages, and the tools for its output: logs, tables, spinners, prompts, and a fake terminal for tests.",
  "keywords": [
    "cli",
    "command-line",
    "terminal",
    "script",
    "parseArgs",
    "spinner",
    "progress",
    "prompts",
    "table",
    "completions"
  ],
  "license": "MIT",
  "author": "Jason Scoppetta",
  "homepage": "https://github.com/ensiria/cli-kit#readme",
  "bugs": {
    "url": "https://github.com/ensiria/cli-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/cli-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "bin": {
    "cli-kit": "dist/bin/cli-kit.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "lint": "biome ci . && eslint .",
    "format": "biome check --write .",
    "prepack": "pnpm build",
    "refs:check": "node tools/check-internal-refs/check-internal-refs.mts",
    "checks": "pnpm typecheck && pnpm lint && pnpm refs:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@nx/js": "24.0.4",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.3",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "nx": "24.0.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "nx": {
    "name": "@ensiria/cli-kit"
  }
}
